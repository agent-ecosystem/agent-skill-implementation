#!/bin/sh
#
# Lints uncommitted .md files with Vale against the DC style.
# Called by .git/hooks/pre-commit; safe to run manually too.
#
# Excluded paths:
#   benchmark-skills/ - probe skills contain deliberate wording (canary
#     phrases, probe instructions) that is part of the test apparatus.
#   benchmark-runner/reports/ - generated by report.go; fix the template,
#     not the output.
#   site/archetypes/ - Hugo templates, not prose; the templated
#     frontmatter breaks Vale's parser.

REPO_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$REPO_DIR" || exit 1

if ! command -v vale >/dev/null 2>&1; then
  echo "vale not found on PATH. Install with: brew install vale" >&2
  exit 1
fi

FILES=$( { git diff --name-only --diff-filter=ACMR -- '*.md'
           git diff --cached --name-only --diff-filter=ACMR -- '*.md'
           git ls-files --others --exclude-standard -- '*.md'
         } | sort -u | grep -v '^benchmark-skills/' \
           | grep -v '^benchmark-runner/reports/' \
           | grep -v '^site/archetypes/')

[ -z "$FILES" ] && exit 0

vale --config .vale.ini $FILES
